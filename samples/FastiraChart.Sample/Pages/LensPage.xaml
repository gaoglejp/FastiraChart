<UserControl x:Class="FastiraChart.Sample.Pages.LensPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="urn:fastirachart:wpf">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Style="{StaticResource OptionsPanel}">
            <TextBlock Style="{StaticResource OptionHeader}" Text="Lens" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="The lens shows the X range LensMinimumX..LensMaximumX magnified, LensWidth wide, at LensHorizontalPosition (0 = left, 1 = right) along the plot. It never moves the plot." />

            <CheckBox Content="IsLensVisible" IsChecked="{Binding IsLensVisible, ElementName=Chart}" />

            <TextBlock Text="{Binding LensMinimumX, ElementName=Chart, StringFormat='LensMinimumX: {0:0.0}'}" Margin="0,8,0,0" />
            <Slider Minimum="0" Maximum="200" Value="{Binding LensMinimumX, ElementName=Chart}" />
            <TextBlock Text="{Binding LensMaximumX, ElementName=Chart, StringFormat='LensMaximumX: {0:0.0}'}" />
            <Slider Minimum="0" Maximum="200" Value="{Binding LensMaximumX, ElementName=Chart}" />
            <TextBlock Text="{Binding LensWidth, ElementName=Chart, StringFormat='LensWidth: {0:0}'}" />
            <Slider Minimum="40" Maximum="600" Value="{Binding LensWidth, ElementName=Chart}" />
            <TextBlock Text="{Binding LensHorizontalPosition, ElementName=Chart, StringFormat='LensHorizontalPosition: {0:0.00}'}" />
            <Slider Minimum="0" Maximum="1" Value="{Binding LensHorizontalPosition, ElementName=Chart}" />
        </StackPanel>

        <fc:FastiraChartControl x:Name="Chart"
                                MinimumX="0" MaximumX="200"
                                MinimumY="-1.6" MaximumY="1.6"
                                MinimumAxisSpace="48,8,16,32"
                                IsLensVisible="True"
                                LensMinimumX="90" LensMaximumX="110"
                                LensWidth="280"
                                LensHorizontalPosition="0.5">
            <fc:FastiraChartControl.Series>
                <fc:LineSeries x:Name="Signal" StrokeThickness="1" />
            </fc:FastiraChartControl.Series>
        </fc:FastiraChartControl>
    </DockPanel>
</UserControl>
