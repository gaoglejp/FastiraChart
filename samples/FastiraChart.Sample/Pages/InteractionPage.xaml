<UserControl x:Class="FastiraChart.Sample.Pages.InteractionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="urn:fastirachart:wpf">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Style="{StaticResource OptionsPanel}">
            <TextBlock Style="{StaticResource OptionHeader}" Text="Interaction" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Every switch is off by default. Wheel: zoom X about the pointer (Shift: Y). Left drag: pan. Over the lens, with lens interaction on, drag moves the lens and the wheel zooms the range it shows." />

            <CheckBox Content="IsZoomEnabled" IsChecked="{Binding IsZoomEnabled, ElementName=Chart}" />
            <CheckBox Content="IsPanEnabled" IsChecked="{Binding IsPanEnabled, ElementName=Chart}" />
            <CheckBox Content="IsLensInteractionEnabled" IsChecked="{Binding IsLensInteractionEnabled, ElementName=Chart}" />
            <CheckBox Content="IsCrosshairVisible" IsChecked="{Binding IsCrosshairVisible, ElementName=Chart}" />
            <CheckBox Content="IsTooltipVisible" IsChecked="{Binding IsTooltipVisible, ElementName=Chart}" />
            <CheckBox Content="IsLensVisible" IsChecked="{Binding IsLensVisible, ElementName=Chart}" />

            <TextBlock Style="{StaticResource OptionHeader}" Text="Current ranges" />
            <TextBlock x:Name="RangeText" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Gestures write MinimumX..MaximumY with SetCurrentValue, so bindings on them survive." />
            <Button Content="Reset view" Click="OnReset" />
        </StackPanel>

        <fc:FastiraChartControl x:Name="Chart"
                                MinimumX="0" MaximumX="200"
                                MinimumY="-1.6" MaximumY="1.6"
                                MinimumAxisSpace="48,8,16,32"
                                IsZoomEnabled="True"
                                IsPanEnabled="True"
                                IsLensInteractionEnabled="True"
                                IsCrosshairVisible="True"
                                IsTooltipVisible="True"
                                LensMinimumX="40" LensMaximumX="60"
                                LensWidth="240" LensHorizontalPosition="0.8">
            <fc:FastiraChartControl.Series>
                <fc:LineSeries x:Name="Signal" StrokeThickness="1.5" />
            </fc:FastiraChartControl.Series>
        </fc:FastiraChartControl>
    </DockPanel>
</UserControl>
