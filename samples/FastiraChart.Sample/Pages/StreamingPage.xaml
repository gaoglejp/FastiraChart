<UserControl x:Class="FastiraChart.Sample.Pages.StreamingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="urn:fastirachart:wpf">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Style="{StaticResource OptionsPanel}">
            <TextBlock Style="{StaticResource OptionHeader}" Text="Streaming" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Append adds one point, AppendRange adds a batch in one update, setting Points replaces everything, and ClearPoints removes every point. The X range follows the newest point." />

            <Button x:Name="StartStopButton" Content="Start Append (timer)" Click="OnStartStop" />
            <Button Content="AppendRange (100 points)" Click="OnAppendRange" />
            <Button Content="Replace Points (last 200 kept)" Click="OnReplace" />
            <Button Content="ClearPoints" Click="OnClear" />

            <TextBlock Style="{StaticResource OptionHeader}" Text="Points" />
            <TextBlock x:Name="CountText" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Text="A LineSeries keeps every point it is given. The timer trims the series to the last 2 000 points, with a replace, whenever it passes 10 000." />
        </StackPanel>

        <fc:FastiraChartControl x:Name="Chart"
                                MinimumX="0" MaximumX="200"
                                MinimumY="-1.5" MaximumY="1.5"
                                MinimumAxisSpace="48,8,16,32">
            <fc:FastiraChartControl.Series>
                <fc:LineSeries x:Name="Stream" StrokeThickness="1.5" />
            </fc:FastiraChartControl.Series>
        </fc:FastiraChartControl>
    </DockPanel>
</UserControl>
