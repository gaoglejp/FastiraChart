<Application x:Class="FastiraChart.Sample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Shared layout for the option panels beside each chart. -->
        <Style x:Key="OptionsPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style x:Key="OptionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#FF5A5A66" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Application.Resources>
</Application>
